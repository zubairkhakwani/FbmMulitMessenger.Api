{
  "manifest_version": 3,
  "name": "FBM Messenger",
  "version": "1.0",
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FBM Messenger"
  },
  "host_permissions": [
    "https://localhost:7095/*",
    "https://*.facebook.com/*",
    "https://*.fbmmessenger.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [ "content.js" ],
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "matches": [ "https://*.facebook.com/*" ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "all_frames": false,
      "js": [ "inject.js" ],
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "matches": [ "https://*.facebook.com/*" ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "signalr.min.js" ],
      "matches": [ "<all_urls>" ]
    }
  ]
}
